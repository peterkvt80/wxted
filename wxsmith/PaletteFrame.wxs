<?xml version="1.0" encoding="utf-8" ?>
<wxsmith>
	<object class="wxFrame" name="PaletteFrame">
		<title>Colour lookup tables</title>
		<size>554,240</size>
		<parent_arg>0</parent_arg>
		<id_arg>0</id_arg>
		<layout_window>0</layout_window>
		<style>wxCAPTION|wxDEFAULT_FRAME_STYLE</style>
		<handler function="OnClosePalette" entry="EVT_CLOSE" />
		<object class="wxChoice" name="ID_CHOICE1" variable="PaletteRemapChoice" member="yes">
			<content>
				<item>Fore 0 Back 0</item>
				<item>Fore 0 Back 1</item>
				<item>Fore 0 Back 2</item>
				<item>Fore 1 Back 1</item>
				<item>Fore 1 Back 2</item>
				<item>Fore 2 Back 1</item>
				<item>Fore 2 Back 2</item>
				<item>Fore 2 Back 3</item>
			</content>
			<selection>0</selection>
			<pos>10,10</pos>
			<size>90,12d</size>
			<tooltip>Choose the foreground and background colour look up tables</tooltip>
			<maxsize>200,100</maxsize>
			<handler function="OnChoice1Select" entry="EVT_CHOICE" />
		</object>
		<object class="wxPanel" name="ID_CLUTPANEL1" variable="ClutPanel1" member="yes">
			<pos>32,56</pos>
			<size>496,32</size>
			<bg>wxSYS_COLOUR_ACTIVECAPTION</bg>
			<object class="wxPanel" name="ID_PANEL1" variable="Panel1" member="yes">
				<pos>24,16</pos>
			</object>
		</object>
		<object class="wxPanel" name="ID_CLUTPANEL2" variable="ClutPanel2" member="yes">
			<pos>32,96</pos>
			<size>472,40</size>
		</object>
		<object class="wxPanel" name="ID_CLUTPANEL3" variable="ClutPanel3" member="yes">
			<pos>32,152</pos>
			<size>496,40</size>
			<bg>wxSYS_COLOUR_ACTIVECAPTION</bg>
		</object>
		<object class="wxPanel" name="ID_CLUTPANEL4" variable="ClutPanel4" member="yes">
			<pos>24,200</pos>
			<size>504,32</size>
		</object>
		<object class="wxColourDialog" variable="ColourDialog1" member="yes" />
	</object>
</wxsmith>
